[Unit]
Description=Remote-Desk Secure Host Streaming Daemon (System Service)
Documentation=https://github.com/Monkey0-9/remote-desk
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/remote-desk-host --unattended --bind 0.0.0.0:4443
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536

# Hardening constraints
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictNamespaces=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
